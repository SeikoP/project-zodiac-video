{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac-video-pipeline.local/schemas/narrative-plan-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "story_shape",
    "delivery_mode",
    "sign",
    "topic",
    "selection_rationale",
    "beats"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "story_shape": {
      "enum": [
        "character_deconstruction",
        "hybrid_deconstruction",
        "micro_story"
      ]
    },
    "delivery_mode": {
      "enum": [
        "direct",
        "conversational"
      ]
    },
    "sign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus"
      ],
      "properties": {
        "focus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selection_rationale": {
      "type": "string",
      "minLength": 1
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/beat"
      }
    },
    "audience_vibe": {
      "enum": [
        "student_peer",
        "neutral",
        "custom"
      ]
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "support",
        "evidence_refs",
        "devices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "enum": [
            "SOURCE-SUPPORTED",
            "EDITORIAL EXAGGERATION",
            "FICTIONAL MICRO-EXAMPLE"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "devices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "hook",
              "riff",
              "micro_scene",
              "narrator_reaction",
              "contradiction",
              "interaction",
              "escalation",
              "payoff",
              "bridge"
            ]
          }
        },
        "contradiction_basis": {
          "type": "string",
          "minLength": 1
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "context_key": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
