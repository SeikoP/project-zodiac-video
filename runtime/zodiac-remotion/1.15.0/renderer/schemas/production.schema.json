{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac-video-pipeline.local/schemas/production-2.0.json",
  "title": "Zodiac sticker-story production contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "video",
    "visual_system",
    "caption_style",
    "primitives",
    "assets",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": "2.0"
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "visual_system": {
      "type": "object",
      "required": [
        "palette",
        "background_primitive",
        "primitive_renderer",
        "motion_presets",
        "transition_presets",
        "sfx_profiles",
        "style_token"
      ],
      "properties": {
        "palette": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "background_primitive": {
          "type": "string"
        },
        "primitive_renderer": {
          "type": "object",
          "required": [
            "allowed_tags"
          ],
          "properties": {
            "allowed_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "motion_presets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "keyframes",
              "easing"
            ],
            "properties": {
              "keyframes": {
                "type": "array",
                "minItems": 2
              },
              "easing": {
                "type": "string"
              }
            }
          }
        },
        "transition_presets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "renderer"
            ],
            "properties": {
              "renderer": {
                "enum": [
                  "instant_cut",
                  "clip_reveal",
                  "opacity_to_zero"
                ]
              },
              "axis": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              }
            }
          }
        },
        "sfx_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "style_token": {
          "type": "object",
          "required": [
            "id",
            "version",
            "source_hash",
            "palette_roles",
            "character_construction",
            "shape_language",
            "caption_emphasis",
            "safe_zone",
            "caption_overlay",
            "motion_grammar"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "source_hash": {
              "type": "string"
            },
            "palette_roles": {
              "type": "object"
            },
            "character_construction": {
              "type": "object"
            },
            "shape_language": {
              "type": "object"
            },
            "caption_emphasis": {
              "type": "object"
            },
            "safe_zone": {
              "type": "object"
            },
            "motion_grammar": {
              "type": "object"
            },
            "caption_overlay": {
              "type": "object"
            }
          }
        }
      }
    },
    "caption_style": {
      "type": "object",
      "required": [
        "font_family",
        "font_size_px",
        "min_font_size_px",
        "font_weight",
        "color",
        "highlight_color",
        "background",
        "safe_area",
        "max_lines"
      ],
      "properties": {
        "font_family": {
          "const": "Patrick Hand"
        },
        "font_size_px": {
          "type": "integer",
          "minimum": 64,
          "maximum": 96
        },
        "min_font_size_px": {
          "type": "integer",
          "minimum": 56,
          "maximum": 84
        },
        "font_weight": {
          "const": 400
        },
        "color": {
          "type": "string"
        },
        "highlight_color": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "safe_area": {
          "$ref": "#/$defs/rect"
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "primitives": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "viewBox",
          "elements"
        ],
        "properties": {
          "kind": {
            "const": "svg_elements"
          },
          "viewBox": {
            "type": "string"
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tag",
                "attributes"
              ],
              "properties": {
                "tag": {
                  "type": "string"
                },
                "attributes": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "category",
          "pose",
          "path",
          "format",
          "style_id",
          "lineage"
        ],
        "properties": {
          "kind": {
            "const": "svg"
          },
          "category": {
            "type": "string"
          },
          "character_id": {
            "type": "string"
          },
          "pose": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "format": {
            "const": "image/svg+xml"
          },
          "style_id": {
            "type": "string"
          },
          "lineage": {
            "$ref": "#/$defs/lineage"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source_library",
        "source_master",
        "semantic_intent"
      ],
      "properties": {
        "mode": {
          "enum": [
            "direct_copy",
            "derived_copy",
            "semantic_variant",
            "composite"
          ]
        },
        "source_library": {
          "const": "zodiac-paper-doodle-asset-library-v3"
        },
        "source_master": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "semantic_intent": {
          "type": "string",
          "minLength": 1
        },
        "mutated_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "category",
        "pose",
        "path",
        "format",
        "style_id",
        "lineage"
      ],
      "properties": {
        "kind": {
          "const": "svg"
        },
        "category": {
          "type": "string"
        },
        "character_id": {
          "type": "string"
        },
        "pose": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "const": "image/svg+xml"
        },
        "style_id": {
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "child_entities",
            "whole_asset"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "justification": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "action",
        "state_before",
        "state_after",
        "trigger",
        "motion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "state_before": {
          "type": "string"
        },
        "state_after": {
          "type": "string"
        },
        "trigger": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "const": "scene_start"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "text"
              ],
              "properties": {
                "source": {
                  "const": "voice_anchor"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "occurrence": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preset",
            "duration_frames"
          ],
          "properties": {
            "preset": {
              "type": "string"
            },
            "duration_frames": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "sfx": {
          "type": "string"
        },
        "mechanism": {
          "$ref": "#/$defs/mechanism"
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "voice",
        "timing",
        "entities",
        "events",
        "transition",
        "captions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "from_voice"
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "initial_state",
              "states"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "character",
                  "object"
                ]
              },
              "initial_state": {
                "type": "string"
              },
              "states": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "transform",
                    "layer",
                    "visible"
                  ],
                  "properties": {
                    "asset": {
                      "type": "string"
                    },
                    "primitive": {
                      "type": "string"
                    },
                    "transform": {
                      "$ref": "#/$defs/rect"
                    },
                    "layer": {
                      "type": "number"
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "oneOf": [
                    {
                      "required": [
                        "asset"
                      ],
                      "not": {
                        "required": [
                          "primitive"
                        ]
                      }
                    },
                    {
                      "required": [
                        "primitive"
                      ],
                      "not": {
                        "required": [
                          "asset"
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "transition": {
          "type": "object",
          "required": [
            "type",
            "duration_frames"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "duration_frames": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "captions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "page_target_words",
            "max_words",
            "max_lines"
          ],
          "properties": {
            "source": {
              "const": "voice"
            },
            "page_target_words": {
              "type": "integer",
              "minimum": 3,
              "maximum": 7
            },
            "max_words": {
              "type": "integer",
              "minimum": 3,
              "maximum": 7
            },
            "max_lines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
