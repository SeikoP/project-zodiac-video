{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://zodiac.local/contracts/director-plan-v1.schema.json",
  "title":"Phase-02 Director v2 authoring plan (never shipped in Job@5)",
  "type":"object","additionalProperties":false,
  "required":["format","narration_sha256","beats"],
  "properties":{
    "format":{"const":"zodiac-director-plan@1"},
    "narration_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "beats":{"type":"array","minItems":1,"items":{
      "type":"object","required":["scene_id","beat_id","voice_anchor","semantic_purpose","performer","action","visual_payoff","shot_reason","supported_motion_or_state","asset_cost_reason"],
      "properties":{
        "scene_id":{"type":"string","minLength":1},"beat_id":{"type":"string","minLength":1},
        "voice_anchor":{"type":"string","minLength":1},"occurrence":{"type":"integer","minimum":1},
        "semantic_purpose":{"enum":["observation","noticing","barrier","subtext","contrast","distance","realization","payoff","setup","reaction","explanation"]},
        "performer":{"type":"string","minLength":1},"target":{"type":["string","null"]},
        "action":{"type":"string","minLength":1},"reaction":{"type":"string"},
        "visual_payoff":{"type":"string","minLength":1},"shot_reason":{"type":"string","minLength":1},
        "supported_motion_or_state":{"enum":["state_swap","hold","pop-in","fade-in","fade-out","subtle-tilt","small-bounce","focus-shift","slide"]},
        "static_reason":{"type":"string"},"asset_cost_reason":{"type":"string","minLength":1},
        "cause_event_id":{"type":"string"},"reaction_event_id":{"type":"string"},"allow_self_reaction":{"type":"boolean"},
        "event_ids":{"type":"array","items":{"type":"string"}},
        "blocking":{"type":"array","items":{"type":"object","required":["entity_id","anchor","side"],"properties":{
          "entity_id":{"type":"string"},"anchor":{"type":"string"},"secondary_anchor":{"type":"string"},
          "side":{"enum":["above","below","left","right","between","above-left","above-right","below-left","below-right"]},
          "offset_px":{"type":"number","minimum":0,"maximum":180},"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0},"relayout":{"type":"boolean"}
        },"additionalProperties":false}}
      },"additionalProperties":false
    }}
  }
}
