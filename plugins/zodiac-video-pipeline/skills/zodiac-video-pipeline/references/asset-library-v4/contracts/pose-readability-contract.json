{
  "version": "1.0-pose-readability-v1",
  "source": "v1.37 visual review regressions",
  "precedence": {
    "visual_intent": "visual-intent-contract.json",
    "pose_readability": "pose-readability-contract.json",
    "geometry": "attachment-resolution.json",
    "conflict_rule": "readability_failure_blocks_compile_even_when_geometry_is_valid"
  },
  "review_status": [
    "GEOMETRY_PASS",
    "SEMANTIC_PASS",
    "VISUAL_REVIEW",
    "PASS"
  ],
  "global_rules": {
    "articulated_actions": {
      "require_joint_readability": true,
      "forbid_single_straight_limb_when_pose_implies_bend": true
    },
    "contact": {
      "require_visible_overlap": true,
      "require_visible_grip_or_support_area": true
    },
    "expression": {
      "allow_semantic_adapter": true,
      "preserve_identity_groups": [
        "body_silhouette",
        "head_outline",
        "hair_back",
        "hair_silhouette",
        "torso",
        "torso_identity"
      ],
      "adaptable_groups": [
        "face_eyes",
        "face_mouth",
        "reaction_marks"
      ]
    },
    "occlusion": {
      "measure_against": "final_character_silhouette",
      "protect": "face_core"
    }
  },
  "recipes": {
    "fake_flex": {
      "pose_read": "smug_showoff",
      "required_contact": [
        "left_hand:chain_grip"
      ],
      "expression_intent": [
        "smug",
        "confident"
      ]
    },
    "awkward": {
      "pose_read": "scratch_head",
      "scratch_hand": "right_hand",
      "scratch_target": "head_right_scratch_region",
      "elbow_required": true,
      "elbow_angle_deg": {
        "min": 45,
        "max": 135
      },
      "hand_to_head_gap_ratio": {
        "max": 0.03
      },
      "arm_forbidden_overlap": [
        "face_core"
      ],
      "snot_locus": "nostril_under_nose_zone",
      "snot_scale_ratio_of_head_width": {
        "min": 0.06,
        "max": 0.13
      },
      "expression_intent": [
        "awkward",
        "confused"
      ]
    },
    "emotional_damage": {
      "pose_read": "two_hand_cup",
      "required_contact": [
        "left_hand:left_cup",
        "right_hand:right_cup"
      ],
      "expression_intent": [
        "hurt",
        "shocked"
      ]
    },
    "heart_offer": {
      "pose_read": "two_hand_present",
      "required_contact": [
        "left_hand:left_support",
        "right_hand:right_support"
      ],
      "expression_intent": [
        "soft",
        "offering"
      ]
    },
    "damage_run": {
      "pose_read": "run_away",
      "expression_intent": [
        "panic",
        "crying"
      ],
      "required_contact": [
        "left_eye:left_tear_start",
        "right_eye:right_tear_start"
      ],
      "trail_side": "right"
    },
    "banner_bonk": {
      "pose_read": "overhead_support",
      "required_contact": [
        "left_hand:support_left",
        "right_hand:support_right"
      ],
      "prop_region": "above_head"
    },
    "rose_peek": {
      "pose_read": "partial_reveal",
      "occluder_side": "left",
      "reveal_side": "right",
      "silhouette_occlusion_ratio": {
        "min": 0.3,
        "max": 0.45
      },
      "face_visible_ratio": {
        "min": 0.55
      },
      "required_contact": [
        "mouth:rose.stem_start"
      ],
      "accent_side": "right",
      "accent_direction": "outward"
    },
    "receipt_shame": {
      "pose_read": "raise_evidence",
      "required_contact": [
        "right_hand:receipt_hold"
      ],
      "hand_prop_overlap_ratio": {
        "min": 0.08,
        "max": 0.35
      },
      "hand_visible_ratio": {
        "min": 0.25
      },
      "expression_intent": [
        "deadpan",
        "embarrassed",
        "caught"
      ],
      "incompatible_expression_cues": [
        "wide_smile",
        "toothy_grin",
        "laughing"
      ],
      "specialist_expression_adapter": "deadpan_embarrassed",
      "adapter_required_when_incompatible": true
    }
  },
  "expression_adapters": {
    "deadpan_embarrassed": {
      "mutate": [
        "face_eyes",
        "face_mouth"
      ],
      "mouth_read": "flat_or_slight_downturn",
      "eye_read": "neutral_or_lowered",
      "forbid": [
        "wide_smile",
        "toothy_grin"
      ],
      "preserve_identity": true
    }
  },
  "minimal_rest": {
    "poses": [
      "rest_sitting",
      "rest_lying"
    ],
    "whole_svg_rotation": false,
    "required_checks": [
      "identity",
      "intrinsic_ratio",
      "support_contact",
      "caption_safe",
      "human_pixel_review"
    ],
    "runner_temporal_status": "PENDING_UNTIL_RENDER"
  }
}
