{
  "version": "1.4-readability-aware",
  "source": "Visual Intent v1 + Pose Readability v1",
  "precedence": {
    "visual_intent": "visual-intent-contract.json",
    "pose_readability": "pose-readability-contract.json",
    "geometry": "attachment-resolution.json",
    "state_recipe": "../recipes/state-recipes.json"
  },
  "policy": {
    "base_sockets_role": "pre_pose_hint_only",
    "pose_space_anchors": "authoritative_after_pose",
    "visual_intent_required": true,
    "pose_readability_required": true,
    "static_effect_slots_role": "fallback_hint_only",
    "forbid": [
      "geometry_pass_overrides_readability_fail",
      "single_segment_scratch_arm",
      "scratch_arm_through_face_core",
      "center_face_snot_blob",
      "rose_peek_under_occlusion",
      "rose_peek_over_occlusion",
      "floating_receipt",
      "hidden_receipt_grip",
      "receipt_shame_with_incompatible_smile",
      "infer_effect_side_from_effect_slot",
      "tear_stream_from_mouth",
      "copy_cross_character_coordinates"
    ]
  },
  "resolution_order": [
    "choose_asset",
    "derive_pose",
    "recompute_semantic_pose_space_anchors",
    "resolve_visual_intent",
    "resolve_pose_readability",
    "apply_expression_adapter_if_required",
    "place_prop_contacts",
    "derive_final_subject_bounds",
    "apply_occlusion_target",
    "place_effect_from_intent",
    "validate_joint_readability",
    "validate_contact_readability",
    "validate_expression_intent",
    "validate_occlusion_readability",
    "compile_runtime_state"
  ],
  "semantic_anchor_rules": {
    "mouth": {
      "preferred_source": "face_mouth",
      "method": "path_bounds_center"
    },
    "eyes": {
      "preferred_source": "face_eyes",
      "method": "semantic_eye_centers"
    },
    "face_core": {
      "source": "head_outline+face_eyes+face_mouth",
      "method": "protected_face_region"
    },
    "head_right_scratch_region": {
      "source": "head_outline",
      "method": "right_upper_contour"
    },
    "nostril_under_nose_zone": {
      "source": "face_eyes+face_mouth",
      "method": "midline_then_small_lateral_offset"
    },
    "hand_contour": {
      "source": "derived_arm_terminal",
      "method": "terminal_hand_bounds"
    },
    "final_character_silhouette": {
      "source": "all_visible_character_groups",
      "method": "post_pose_union_bounds"
    }
  },
  "geometry_rules": {
    "fake_flex": {
      "prop": "gold-chain",
      "contact": [
        "chest_center",
        "left_hand"
      ],
      "effect": "tiny-sparkle",
      "effect_reference": "prop_bounds"
    },
    "awkward": {
      "prop": "snot-drop",
      "scratch": {
        "hand": "right_hand",
        "target": "head_right_scratch_region",
        "elbow_required": true,
        "elbow_side": "outside_face_core",
        "elbow_angle_deg": {
          "min": 45,
          "max": 135
        },
        "hand_to_target_gap_ratio": {
          "max": 0.03
        }
      },
      "snot": {
        "locus": "nostril_under_nose_zone",
        "scale_ratio_of_head_width": {
          "min": 0.06,
          "max": 0.13
        }
      },
      "effect": "question-accent",
      "effect_reference": "head_bounds"
    },
    "emotional_damage": {
      "prop": "broken-heart",
      "contact": [
        "chest_center",
        "left_hand",
        "right_hand"
      ],
      "effect": null
    },
    "heart_offer": {
      "prop": "heart-hold",
      "contact": [
        "chest_center",
        "left_hand",
        "right_hand"
      ],
      "effect": null
    },
    "damage_run": {
      "prop": "tear-stream",
      "contact": [
        "left_eye",
        "right_eye"
      ],
      "effect": "speed-lines",
      "effect_reference": "final_body_bounds",
      "motion_direction": "left",
      "trail_side": "right",
      "gap_ratio": {
        "min": 0.02,
        "max": 0.1
      }
    },
    "banner_bonk": {
      "prop": "banner-board",
      "contact": [
        "left_hand",
        "right_hand"
      ],
      "prop_region": "above_head",
      "effect": "impact-lines",
      "effect_reference": "prop_bounds"
    },
    "rose_peek": {
      "prop": "rose",
      "contact": [
        "mouth"
      ],
      "contact_endpoint": "stem_start",
      "occluder_side": "left",
      "reveal_side": "right",
      "silhouette_occlusion_ratio": {
        "min": 0.3,
        "max": 0.45
      },
      "face_visible_ratio": {
        "min": 0.55
      },
      "effect": "peek-edge-lines",
      "effect_side": "right",
      "effect_direction": "outward",
      "effect_reference": "head_bounds",
      "gap_ratio": {
        "min": 0.04,
        "max": 0.18
      }
    },
    "receipt_shame": {
      "prop": "receipt",
      "contact": [
        "right_hand"
      ],
      "grip": {
        "overlap_ratio": {
          "min": 0.08,
          "max": 0.35
        },
        "hand_visible_ratio": {
          "min": 0.25
        }
      },
      "expression_adapter": "deadpan_embarrassed",
      "effect": "tiny-emphasis-tick",
      "effect_reference": "prop_bounds"
    }
  }
}
