{
  "version": "1.0-visual-intent-v1",
  "source": "Final Selected Demo v2 + v1.36 review regressions",
  "precedence": {
    "recipe_identity": "../recipes/state-recipes.json",
    "visual_semantics": "visual-intent-contract.json",
    "geometry_resolution": "attachment-resolution.json",
    "runtime": "ordinary production v2 state/event contract",
    "conflict_rule": "visual_intent_wins_for_side_direction_locus_facial_origin"
  },
  "semantic_axes": {
    "side": [
      "left",
      "right",
      "center",
      "front",
      "rear",
      "upper",
      "lower"
    ],
    "direction": [
      "left",
      "right",
      "up",
      "down",
      "inward",
      "outward",
      "toward_audience",
      "away_from_audience"
    ],
    "z_order": [
      "behind_character",
      "character_plane",
      "above_character",
      "above_prop"
    ],
    "locus": [
      "prop",
      "face",
      "head",
      "torso",
      "frame",
      "reveal_side",
      "trail_side",
      "contact_region"
    ]
  },
  "derived_semantic_anchors": {
    "left_eye": {
      "source": "face_eyes",
      "method": "left_eye_center"
    },
    "right_eye": {
      "source": "face_eyes",
      "method": "right_eye_center"
    },
    "left_cheek": {
      "source": "left_eye+face_bounds",
      "method": "eye_down_offset"
    },
    "right_cheek": {
      "source": "right_eye+face_bounds",
      "method": "eye_down_offset"
    },
    "face_left": {
      "source": "head_outline",
      "method": "face_bounds_left"
    },
    "face_right": {
      "source": "head_outline",
      "method": "face_bounds_right"
    },
    "face_core": {
      "source": "head_outline+face_eyes+face_mouth",
      "method": "protected_face_region"
    },
    "head_left": {
      "source": "head_outline",
      "method": "bounds_left"
    },
    "head_right": {
      "source": "head_outline",
      "method": "bounds_right"
    },
    "torso_left": {
      "source": "torso",
      "method": "bounds_left"
    },
    "torso_right": {
      "source": "torso",
      "method": "bounds_right"
    },
    "body_front": {
      "source": "final_character_bounds+focus",
      "method": "intent_front_side"
    },
    "body_rear": {
      "source": "final_character_bounds+motion_direction",
      "method": "opposite_motion_side"
    },
    "reveal_left": {
      "source": "occluder_side",
      "method": "opposite_occluder_left"
    },
    "reveal_right": {
      "source": "occluder_side",
      "method": "opposite_occluder_right"
    },
    "trail_left": {
      "source": "motion_direction",
      "method": "explicit_trail_side"
    },
    "trail_right": {
      "source": "motion_direction",
      "method": "explicit_trail_side"
    }
  },
  "effect_grammar": {
    "tiny-sparkle": {
      "semantic_role": "show_off_accent",
      "reference_geometry": "prop_bounds",
      "orientation": "outward",
      "forbidden_overlap": [
        "face_core"
      ],
      "max_subject_gap_ratio": 0.18
    },
    "question-accent": {
      "semantic_role": "uncertainty_accent",
      "reference_geometry": "head_bounds",
      "orientation": "outward",
      "forbidden_overlap": [
        "face_core"
      ],
      "max_subject_gap_ratio": 0.14
    },
    "tear-stream": {
      "semantic_role": "cry_trace",
      "reference_geometry": "eyes_or_cheeks",
      "orientation": "down",
      "forbidden_origins": [
        "mouth"
      ],
      "max_subject_gap_ratio": 0.03
    },
    "speed-lines": {
      "semantic_role": "motion_trail",
      "reference_geometry": "final_body_bounds",
      "orientation": "with_motion_axis",
      "forbidden_overlap": [
        "face_core"
      ],
      "max_subject_gap_ratio": 0.1
    },
    "impact-lines": {
      "semantic_role": "impact_accent",
      "reference_geometry": "prop_bounds",
      "orientation": "outward",
      "forbidden_overlap": [
        "face_core"
      ],
      "max_subject_gap_ratio": 0.15
    },
    "peek-edge-lines": {
      "semantic_role": "reveal_accent",
      "reference_geometry": "head_bounds+reveal_side",
      "orientation": "outward",
      "forbidden_overlap": [
        "face_core"
      ],
      "max_subject_gap_ratio": 0.18
    },
    "tiny-emphasis-tick": {
      "semantic_role": "evidence_emphasis",
      "reference_geometry": "prop_bounds",
      "orientation": "outward",
      "forbidden_overlap": [
        "face_core"
      ],
      "max_subject_gap_ratio": 0.14
    }
  },
