{
  "format": "zodiac-environment-compositions@1",
  "version": "1.0.0",
  "policy": {
    "composition_only": true,
    "full_scene_backgrounds": false,
    "default_mode": "micro_environment",
    "fallback_mode": "minimal",
    "runtime_contract": "ordinary_scene_entities_only",
    "max_decorative_only_props": 2,
    "subject_priority": "character_and_story_action",
    "required_depth_order": [
      "rear",
      "subject",
      "front"
    ],
    "grounding_required_for_micro": true
  },
  "modes": {
    "micro_environment": {
      "requires_profile": true,
      "min_semantic_props": 3,
      "requires_cross_depth": true,
      "requires_grounding": true
    },
    "minimal": {
      "requires_profile": false,
      "min_semantic_props": 0,
      "requires_cross_depth": false,
      "requires_grounding": false
    },
    "none": {
      "requires_profile": false,
      "min_semantic_props": 0,
      "requires_cross_depth": false,
      "requires_grounding": false
    }
  },
  "structural_cues": [
    {
      "id": "contact-shadow",
      "role": "grounding",
      "ownership": "package_owned_derivative"
    },
    {
      "id": "floor-patch",
      "role": "grounding",
      "ownership": "package_owned_derivative"
    },
    {
      "id": "depth-rail",
      "role": "directional_depth",
      "ownership": "package_owned_derivative"
    },
    {
      "id": "paper-zone",
      "role": "rear_cluster",
      "ownership": "package_owned_derivative"
    },
    {
      "id": "edge-accent",
      "role": "edge_balance",
      "ownership": "package_owned_derivative"
    },
    {
      "id": "paper-strip",
      "role": "micro_structure",
      "ownership": "package_owned_derivative"
    }
  ],
