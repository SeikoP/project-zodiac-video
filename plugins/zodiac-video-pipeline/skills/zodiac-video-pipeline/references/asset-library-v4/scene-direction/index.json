{
  "format": "zodiac-scene-direction@1",
  "version": "1.1.0",
  "policy": {
    "compile_time_only": true,
    "runtime_contract": "existing_scene_entities_and_camera_primitives",
    "profiles_are": "accelerators_not_whitelist",
    "max_same_shot_streak": 2,
    "max_same_signature_streak": 2,
    "window_size": 4,
    "min_distinct_shots_per_window": 2,
    "environment_change_for_variety": false,
    "shot_change_counts_as_story_state_change": false,
    "placements": [
      "center",
      "left",
      "right",
      "split",
      "full"
    ],
    "continuity_relations": [
      "start",
      "continue",
      "reframe",
      "insert",
      "location_change",
      "payoff_break"
    ]
  },
  "shots": [
    {
      "id": "wide-environment",
      "scale_band": "wide",
      "purpose": [
        "establish_context",
        "location_shift",
        "group_context"
      ],
      "foreground": "optional",
      "placements": [
        "center",
        "left",
        "right",
        "full"
      ]
    },
    {
      "id": "medium-character",
      "scale_band": "medium",
      "purpose": [
        "narration",
        "action",
        "explanation"
      ],
      "foreground": "optional",
      "placements": [
        "center",
        "left",
        "right"
      ]
    },
    {
      "id": "two-person",
      "scale_band": "medium_wide",
      "purpose": [
        "conversation",
        "relationship",
        "shared_action",
        "conflict"
      ],
      "foreground": "optional",
      "placements": [
        "split"
      ],
      "requires_interaction_roles": true
    },
    {
      "id": "reaction-closeup",
      "scale_band": "close",
      "purpose": [
        "reaction",
        "payoff",
        "micro_expression"
      ],
      "foreground": "discouraged",
      "placements": [
        "center",
        "left",
        "right"
      ]
    },
    {
      "id": "prop-insert",
      "scale_band": "detail",
      "purpose": [
        "evidence",
        "object_detail",
        "message",
        "story_prop"
      ],
      "foreground": "focus_is_prop",
      "placements": [
        "center",
        "left",
        "right",
        "full"
      ]
    },
    {
      "id": "over-shoulder",
      "scale_band": "medium_close",
      "purpose": [
        "observe_other",
        "inspect_prop",
        "conversation_reframe"
      ],
      "foreground": "participant_or_prop",
      "placements": [
        "left",
        "right"
      ]
    },
    {
      "id": "foreground-peek",
      "scale_band": "medium_close",
      "purpose": [
        "depth_reveal",
        "comic_peek",
        "intimacy"
      ],
      "foreground": "required",
      "placements": [
        "left",
        "right",
        "center"
      ]
    },
    {
      "id": "caption-led",
      "scale_band": "variable",
      "purpose": [
        "verbal_payoff",
        "quote",
        "final_reframe"
      ],
      "foreground": "restrained",
      "placements": [
        "center",
        "left",
        "right",
        "full"
      ]
    }
  ],
  "rhythm_patterns": [
    {
      "id": "setup",
      "sequence": [
        "wide-environment",
        "medium-character",
        "reaction-closeup"
      ]
    },
    {
      "id": "interaction",
      "sequence": [
        "two-person",
        "over-shoulder",
        "reaction-closeup"
      ]
    },
    {
      "id": "detail",
      "sequence": [
        "medium-character",
        "prop-insert",
        "reaction-closeup"
      ]
    },
    {
      "id": "payoff",
      "sequence": [
        "medium-character",
        "foreground-peek",
        "caption-led"
      ]
    }
  ],
  "compiler": {
    "profile": "compiler-profile.json",
    "cli": "compile-scene-direction.mjs",
    "validation": "validate-scene-direction-compile.mjs",
    "materializes": "state.transform",
    "receipt": ".authoring/scene-direction-compile-receipt.json"
  }
}
