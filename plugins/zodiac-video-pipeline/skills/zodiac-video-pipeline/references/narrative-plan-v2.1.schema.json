{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac-video-pipeline.local/schemas/narrative-plan-2.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "story_shape",
    "delivery_mode",
    "topic",
    "selection_rationale",
    "story_spine",
    "beats",
    "episode_scope",
    "member_lenses"
  ],
  "properties": {
    "version": {
      "const": "2.1"
    },
    "story_shape": {
      "enum": [
        "character_deconstruction"
      ]
    },
    "delivery_mode": {
      "enum": [
        "direct",
        "conversational"
      ]
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus"
      ],
      "properties": {
        "focus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selection_rationale": {
      "type": "string",
      "minLength": 1
    },
    "story_spine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_tension",
        "starting_read",
        "progression_intent",
        "payoff_target"
      ],
      "properties": {
        "identity_tension": {
          "type": "string",
          "minLength": 1
        },
        "starting_read": {
          "type": "string",
          "minLength": 1
        },
        "progression_intent": {
          "type": "string",
          "minLength": 1
        },
        "payoff_target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/beat"
      }
    },
    "audience_vibe": {
      "enum": [
        "student_peer",
        "neutral",
        "custom"
      ]
    },
    "selected_concept_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_scope": {
      "type": "object"
    },
    "member_lenses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object"
      }
    },
    "mock_ad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology",
        "treatment",
        "commercial_duration_s",
        "return_mechanism",
        "story_before_anchor",
        "story_after_anchor",
        "fictional_product",
        "text"
      ],
      "properties": {
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "treatment": {
          "type": "string",
          "minLength": 1
        },
        "commercial_duration_s": {
          "type": "number",
          "minimum": 5,
          "maximum": 18
        },
        "return_mechanism": {
          "type": "string",
          "minLength": 1
        },
        "story_before_anchor": {
          "type": "string",
          "minLength": 1
        },
        "story_after_anchor": {
          "type": "string",
          "minLength": 1
        },
        "fictional_product": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "story_hijack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger",
            "pivot",
            "product_reveal",
            "demo",
            "wordplay",
            "cta",
            "snapback"
          ],
          "properties": {
            "trigger": {
              "type": "string",
              "minLength": 1
            },
            "pivot": {
              "type": "string",
              "minLength": 1
            },
            "product_reveal": {
              "type": "string",
              "minLength": 1
            },
            "demo": {
              "type": "string",
              "minLength": 1
            },
            "wordplay": {
              "type": "string",
              "minLength": 1
            },
            "cta": {
              "type": "string",
              "minLength": 1
            },
            "snapback": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "narrative_visuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/narrative_visual"
      }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "semantic_delta",
        "support",
        "evidence_refs",
        "devices",
        "performance",
        "member_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "semantic_delta": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "enum": [
            "SOURCE-SUPPORTED",
            "EDITORIAL EXAGGERATION",
            "FICTIONAL MICRO-EXAMPLE"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "devices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "hook",
              "riff",
              "micro_scene",
              "narrator_reaction",
              "contradiction",
              "interaction",
              "escalation",
              "payoff",
              "bridge"
            ]
          }
        },
        "contradiction_basis": {
          "type": "string",
          "minLength": 1
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "context_key": {
          "type": "string",
          "minLength": 1
        },
        "voice_anchor": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delivery",
            "energy",
            "emotion",
            "pace",
            "emphasis",
            "reason"
          ],
          "properties": {
            "delivery": {
              "type": "string",
              "minLength": 1
            },
            "energy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "emotion": {
              "type": "string",
              "minLength": 1
            },
            "pace": {
              "enum": [
                "slow",
                "medium",
                "fast"
              ]
            },
            "emphasis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "member_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "narrative_visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "beat_ids",
        "evidence_refs",
        "trait_basis",
        "story_tension",
        "claim",
        "concept_fit",
        "concept_candidates",
        "selected_concept",
        "selection_reason",
        "humor_mechanism",
        "payoff_image"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "beat_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trait_basis": {
          "type": "string",
          "minLength": 12
        },
        "story_tension": {
          "type": "string",
          "minLength": 12
        },
        "claim": {
          "type": "string",
          "minLength": 12
        },
        "concept_fit": {
          "type": "string",
          "minLength": 12
        },
        "concept_candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal",
            "metaphor",
            "exaggeration"
          ],
          "properties": {
            "literal": {
              "type": "string",
              "minLength": 12
            },
            "metaphor": {
              "type": "string",
              "minLength": 12
            },
            "exaggeration": {
              "type": "string",
              "minLength": 12
            }
          }
        },
        "selected_concept": {
          "enum": [
            "literal",
            "metaphor",
            "exaggeration"
          ]
        },
        "selection_reason": {
          "type": "string",
          "minLength": 12
        },
        "humor_mechanism": {
          "type": "string",
          "minLength": 12
        },
        "payoff_image": {
          "type": "string",
          "minLength": 12
        }
      }
    }
  }
}
