{
  "format": "zodiac-phase-manifest@2",
  "id": "01-content",
  "order": 1,
  "title": "Content",
  "review_boundary": "required",
  "steps": [
    {
      "id": "evidence",
      "title": "Evidence",
      "required_capabilities": [
        {
          "id": "current_entry_identity",
          "kind": "internal_validator",
          "when": "fresh",
          "tool_locator": "orchestration/verify-entry-freshness.mjs",
          "required_arg_suffixes": [
            "loaded-entry-identity.json"
          ],
          "unavailable_policy": "block",
          "stage": "entry"
        },
        {
          "id": "exa_discovery",
          "kind": "external_tool",
          "when": "fresh",
          "guidance_uri": "skills://plugins/app-69ea4ed2cf7c8191b742ef3622479ddd/Search",
          "tool_locator": "mcp__Exa__web_search_exa",
          "unavailable_policy": "fallback",
          "fallback_providers": [
            "tavily"
          ],
          "stage": "entry",
          "provider": "exa"
        },
        {
          "id": "parallel_verify",
          "kind": "external_tool",
          "when": "fresh",
          "tool_locator": "mcp__Parallel_Search__web_search",
          "unavailable_policy": "fallback",
          "stage": "entry",
          "provider": "parallel",
          "fallback_providers": [
            "tavily",
            "built_in"
          ]
        },
        {
          "id": "evidence_brief_compile",
          "kind": "internal_compiler",
          "when": "fresh",
          "tool_locator": "core/evidence/compile-evidence-brief.mjs",
          "required_arg_suffixes": [
            "--write"
          ],
          "unavailable_policy": "block",
          "stage": "exit"
        },
        {
          "id": "evidence_contract_validation",
          "kind": "internal_validator",
          "when": "always",
          "tool_locator": "references/validate-evidence-contract.mjs",
          "unavailable_policy": "block",
          "stage": "exit"
        }
      ],
      "conditional_capabilities": [
        {
          "id": "firecrawl_extract",
          "kind": "external_tool",
          "when": "flag:hard_to_extract",
          "tool_locator": "mcp__Firecrawl__firecrawl_scrape",
          "unavailable_policy": "block",
          "stage": "entry"
        },
        {
          "id": "series_tracker_contract",
          "kind": "internal_reference",
          "when": "flag:series_tracker",
          "guidance_uri": "references/series-tracker.md",
          "unavailable_policy": "block",
          "stage": "entry"
        },
        {
          "id": "episode_research_scope_validation",
          "kind": "internal_validator",
          "when": "flag:episode_selected",
          "tool_locator": "features/episode/validate-episode-scope.mjs",
          "unavailable_policy": "block",
          "stage": "exit",
          "required_arg_suffixes": [
            "--research"
          ]
        }
      ],
      "allowed_context_categories": [
        "current_request",
        "current_attachment",
        "canonical_contract",
        "live_research",
        "series_selection",
        "series_candidate_screen",
        "episode_scope"
      ],
      "forbidden_context_categories": [
        "memory",
        "prior_chat",
        "old_package",
        "continuity_snapshot",
        "sign_example",
        "series_tracker_raw",
        "asset_rules",
        "renderer_rules",
        "writer_qc",
        "unselected_member_profiles"
      ],
      "required_outputs": [
        "evidence-ledger.json",
        "evidence-summary.md"
      ],
      "conditional_outputs": [
        {
          "name": "series-candidate-screen.json",
          "when": "flag:series_auto_select"
        },
        {
          "name": "evidence-brief.json",
          "when": "fresh"
        },
        {
          "name": "research-scope.json",
          "when": "flag:episode_selected"
        }
      ],
      "gate_checks": [
        "evidence_boundary",
        "source_coverage",
        "evidence_contract"
      ],
      "conditional_gate_checks": [
        {
          "name": "series_candidate_screen",
          "when": "flag:series_auto_select"
        },
        {
          "name": "series_selection_resolved",
          "when": "flag:series_tracker"
        }
      ],
      "allowed_operations": [
        "read_context",
        "external_tool_call",
        "write_authoring"
      ],
      "load_references": [
        "references/context-isolation.md",
        "references/research-and-viral-tools.md",
        "references/episode-formats.md"
      ]
    },
    {
