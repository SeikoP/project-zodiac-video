{
  "format": "zodiac-phase-manifest@2",
  "id": "01-content",
  "order": 1,
  "title": "Content",
  "review_boundary": "required",
  "steps": [
    {
      "id": "evidence",
      "title": "Evidence",
      "required_capabilities": [
        {
          "id": "exa_discovery",
          "kind": "external_tool",
          "when": "fresh",
          "guidance_uri": "skills://plugins/app-69ea4ed2cf7c8191b742ef3622479ddd/Search",
          "tool_locator": "mcp__Exa__web_search_exa",
          "unavailable_policy": "fallback",
          "fallback_providers": [
            "tavily"
          ],
          "stage": "entry"
        },
        {
          "id": "parallel_verify",
          "kind": "external_tool",
          "when": "fresh",
          "tool_locator": "mcp__Parallel_Search__web_search",
          "unavailable_policy": "block",
          "stage": "entry"
        },
        {
          "id": "evidence_contract_validation",
          "kind": "internal_validator",
          "when": "always",
          "tool_locator": "references/validate-evidence-contract.mjs",
          "unavailable_policy": "block",
          "stage": "exit"
        }
      ],
      "conditional_capabilities": [
        {
          "id": "firecrawl_extract",
          "kind": "external_tool",
          "when": "flag:hard_to_extract",
          "tool_locator": "mcp__Firecrawl__firecrawl_scrape",
          "unavailable_policy": "block",
          "stage": "entry"
        },
        {
          "id": "series_tracker_contract",
          "kind": "internal_reference",
          "when": "flag:series_tracker",
          "guidance_uri": "references/series-tracker.md",
          "unavailable_policy": "block",
          "stage": "entry"
        }
      ],
      "allowed_context_categories": [
        "current_request",
        "current_attachment",
        "canonical_contract",
        "live_research",
        "series_selection",
        "series_candidate_screen"
      ],
      "forbidden_context_categories": [
        "memory",
        "prior_chat",
        "old_package",
        "continuity_snapshot",
        "sign_example",
        "series_tracker_raw",
        "asset_rules",
        "renderer_rules",
        "writer_qc"
      ],
      "required_outputs": [
        "evidence-ledger.json",
        "evidence-summary.md"
      ],
      "conditional_outputs": [
        {
          "name": "series-candidate-screen.json",
          "when": "flag:series_auto_select"
        }
      ],
      "gate_checks": [
        "evidence_boundary",
        "source_coverage",
        "evidence_contract"
      ],
      "conditional_gate_checks": [
        {
          "name": "series_candidate_screen",
          "when": "flag:series_auto_select"
        },
        {
          "name": "series_selection_resolved",
          "when": "flag:series_tracker"
        }
      ],
      "allowed_operations": [
        "read_context",
        "external_tool_call",
        "write_authoring"
      ],
      "load_references": [
        "references/context-isolation.md",
        "references/research-and-viral-tools.md"
      ]
    },
    {
      "id": "concept",
      "title": "Concept + Story Engine",
      "required_capabilities": [
        {
          "id": "content_contract_validation",
          "kind": "internal_validator",
          "when": "always",
          "tool_locator": "references/validate-content-contract.mjs",
          "unavailable_policy": "block",
          "stage": "exit"
        }
      ],
      "conditional_capabilities": [
        {
          "id": "viral_analysis",
          "kind": "guidance_skill",
          "when": "flag:viral_support_needed",
          "guidance_uri": "skills://plugins/gpt-36cbaf94d3de76ac0e1999fdc4fb0b22/instructions",
          "unavailable_policy": "block",
          "stage": "entry",
          "require_application_summary": true
        },
        {
          "id": "vidiq_reference_analysis",
          "kind": "external_tool",
          "when": "flag:reference_analysis",
          "guidance_uri": "skills://plugins/app-69dd11f3e50c8191b1ca48d03cf7e2ad/vidiq-shorts-inspiration",
          "tool_locator": "mcp__vidIQ__vidiq_watch_shortform_content",
          "unavailable_policy": "block",
          "stage": "entry"
        }
      ],
      "allowed_context_categories": [
        "current_request",
        "current_attachment",
        "evidence_summary",
        "canonical_contract",
        "explicit_reference",
        "capability_output",
        "series_selection"
      ],
      "forbidden_context_categories": [
        "memory",
        "prior_chat",
        "old_package",
        "sign_example",
        "series_tracker_raw",
        "full_research",
        "asset_rules",
        "renderer_rules",
        "runtime_rules"
      ],
      "required_outputs": [
        "concept-candidates.json",
        "viral-analysis.json",
        "reference-mechanics.json",
        "narrative-plan.json",
        "phase3-writer-brief.json"
      ],
      "gate_checks": [
        "premise_competition",
        "concept_fit",
        "evidence_mapping",
        "viral_application",
        "reference_mechanics_compiled",
        "story_spine",
        "semantic_progression",
        "content_lineage"
      ],
      "allowed_operations": [
        "read_context",
        "external_tool_call",
        "write_authoring"
      ],
      "load_references": [
        "references/viral-routing-policy.md",
        "references/content-craft.md",
        "references/narrative-modes.md",
        "references/narration-writer-brief.md",
        "references/character-viral-performance.md",
        "references/content-quality-engine.md"
      ]
    },
    {
      "id": "narration",
      "title": "Narration",
      "required_capabilities": [
        {
          "id": "phase3_writer_contract",
          "kind": "internal_reference",
          "when": "always",
          "guidance_uri": "references/narrator-performance.md",
          "unavailable_policy": "block",
          "stage": "entry"
        },
        {
          "id": "narrative_qc",
          "kind": "internal_validator",
          "when": "always",
          "tool_locator": "references/validate-narrative.mjs",
          "unavailable_policy": "block",
          "stage": "exit"
        },
        {
          "id": "narrative_qc_decision_validation",
          "kind": "internal_validator",
          "when": "always",
          "tool_locator": "references/validate-narrative-qc.mjs",
          "unavailable_policy": "block",
          "stage": "exit",
          "required_arg_suffixes": [
            "narrative-qc.json",
            "narration.txt"
          ]
        },
        {
          "id": "story_spine_realization_review",
          "kind": "internal_validator",
          "when": "always",
          "tool_locator": "references/validate-story-spine-performance.mjs",
          "unavailable_policy": "block",
          "stage": "exit",
          "required_arg_suffixes": [
            "narrative-plan.json",
            "narration.txt",
            "story-spine-performance.json"
          ]
        },
        {
          "id": "story_quality_review_validation",
          "kind": "internal_validator",
          "when": "flag:content_quality_engine",
          "tool_locator": "references/validate-story-quality-review.mjs",
          "unavailable_policy": "block",
          "stage": "exit"
        }
      ],
      "conditional_capabilities": [],
      "allowed_context_categories": [
        "current_request",
        "phase3_writer_brief",
        "minimal_evidence",
        "reference_mechanics"
      ],
      "forbidden_context_categories": [
        "memory",
        "prior_chat",
        "old_package",
        "sign_example",
        "series_tracker_raw",
        "series_selection",
        "full_research",
        "narrative_plan",
        "current_attachment",
        "explicit_reference",
        "asset_rules",
        "renderer_rules",
        "package_rules",
        "runtime_rules",
        "interaction_rules",
        "full_qc"
      ],
      "required_outputs": [
        "narration.txt",
        "narrative-qc.json",
        "story-spine-performance.json",
        "story-quality-review.json"
      ],
      "gate_checks": [
        "narration_ready_for_review",
        "narrative_qc",
        "narrative_qc_decision",
        "narrative_qc_grounding",
        "story_spine_performance",
        "story_quality_review"
      ],
      "allowed_operations": [
        "read_context",
        "write_authoring"
      ],
      "load_references": [
        "references/narration-writer-brief.md",
        "references/story-spine-performance.md",
        "references/content-quality-engine.md"
      ]
    }
  ]
}
