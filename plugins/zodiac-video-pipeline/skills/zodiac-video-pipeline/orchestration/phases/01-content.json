          "unavailable_policy": "block",
          "stage": "entry",
          "require_application_summary": true
        },
        {
          "id": "vidiq_reference_analysis",
          "kind": "external_tool",
          "when": "flag:reference_analysis",
          "guidance_uri": "skills://plugins/app-69dd11f3e50c8191b1ca48d03cf7e2ad/vidiq-shorts-inspiration",
          "tool_locator": "mcp__vidIQ__vidiq_watch_shortform_content",
          "unavailable_policy": "block",
          "stage": "entry"
        },
        {
          "id": "episode_scope_validation",
          "kind": "internal_validator",
          "when": "flag:episode_selected",
          "tool_locator": "features/episode/validate-episode-scope.mjs",
          "unavailable_policy": "block",
          "stage": "exit"
