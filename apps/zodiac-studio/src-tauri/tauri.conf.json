{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zodiac Studio V5 Preview",
  "version": "0.1.0",
  "identifier": "com.bungmoto.zodiac.studio.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zodiac Studio  ✦  Phase 1",
        "width": 1380,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 650,
        "center": true,
        "backgroundColor": "#10121a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
