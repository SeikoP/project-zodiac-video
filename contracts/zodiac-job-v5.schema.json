{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac.local/contracts/zodiac-job-v5.schema.json",
  "type": "object",
  "required": [
    "format",
    "job",
    "contract",
    "renderer",
    "producer"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "zodiac-job@5"
    },
    "contract": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "zodiac-authoring-ir"
        },
        "version": {
          "const": "1.0.0"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "renderer": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "zodiac-renderer"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "producer": {
      "type": "object",
      "required": [
        "plugin",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
