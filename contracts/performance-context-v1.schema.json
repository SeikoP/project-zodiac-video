{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac.local/contracts/performance-context-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "delivery": {"type": "string", "minLength": 1},
    "energy": {"type": "number", "minimum": 0, "maximum": 1},
    "emotion": {"type": "string", "minLength": 1},
    "pace": {"enum": ["slow", "medium", "fast"]},
    "emphasis": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "continuity_group": {"type": "string", "minLength": 1},
    "motion_duration_ms": {"type": "integer", "minimum": 1, "maximum": 10000},
    "transition_duration_ms": {"type": "integer", "minimum": 1, "maximum": 10000}
  }
}
