{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac.local/contracts/authoring-ir-v1.schema.json",
  "type": "object",
  "required": [
    "format",
    "fps",
    "video",
    "assets",
    "scenes"
  ],
  "additionalProperties": false,
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "states"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "initial_state": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        }
      }
    },
    "trigger": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "voice_anchor"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "occurrence": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "scene_start"
            }
          }
        }
      ]
    },
    "scheduling": {
      "type": "object",
      "required": [
        "max_drift_frames",
        "merge_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "max_drift_frames": {
          "type": "integer",
          "minimum": 0
        },
        "merge_policy": {
          "enum": [
            "never",
            "same_intent_same_state"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "target",
        "intent",
        "trigger",
        "state_before",
        "state_after",
        "desired_motion",
        "scheduling"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "state_before": {
          "type": "string",
          "minLength": 1
        },
        "state_after": {
          "type": "string",
          "minLength": 1
        },
        "desired_motion": {
          "type": "string",
          "minLength": 1
        },
        "scheduling": {
          "$ref": "#/$defs/scheduling"
        }
      }
    },
    "performance_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delivery": {"type": "string", "minLength": 1},
        "energy": {"type": "number", "minimum": 0, "maximum": 1},
        "emotion": {"type": "string", "minLength": 1},
        "pace": {"enum": ["slow", "medium", "fast"]},
        "emphasis": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "continuity_group": {"type": "string", "minLength": 1},
        "motion_duration_ms": {"type": "integer", "minimum": 1, "maximum": 10000},
        "transition_duration_ms": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "voice",
        "duration_hint_frames",
        "entities",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string"
        },
        "performance_context": {
          "$ref": "#/$defs/performance_context"
        },
        "duration_hint_frames": {
          "type": "integer",
          "minimum": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    }
  },
  "properties": {
    "format": {
      "const": "zodiac-authoring-ir@1"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "video": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  }
}
