{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac.local/contracts/authoring-ir-v1.schema.json",
  "type": "object",
  "required": [
    "format",
    "fps",
    "video",
    "assets",
    "scenes"
  ],
  "additionalProperties": false,
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "states"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "initial_state": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        }
      }
    },
    "trigger": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "voice_anchor"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "occurrence": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "scene_start"
            }
          }
        }
      ]
    },
    "scheduling": {
      "type": "object",
      "required": [
        "max_drift_frames",
        "merge_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "max_drift_frames": {
          "type": "integer",
          "minimum": 0
        },
        "merge_policy": {
          "enum": [
            "never",
            "same_intent_same_state"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "target",
        "intent",
        "trigger",
        "state_before",
        "state_after",
        "desired_motion",
        "scheduling"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "state_before": {
          "type": "string",
          "minLength": 1
        },
        "state_after": {
          "type": "string",
          "minLength": 1
        },
        "desired_motion": {
          "type": "string",
          "minLength": 1
        },
        "scheduling": {
          "$ref": "#/$defs/scheduling"
        }
      }
    },
    "performance_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "type": "string",
          "minLength": 1
        },
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emotion": {
          "type": "string",
          "minLength": 1
        },
        "pace": {
          "enum": [
            "slow",
            "medium",
            "fast"
          ]
        },
        "emphasis": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "continuity_group": {
          "type": "string",
          "minLength": 1
        },
        "motion_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "transition_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "voice",
        "duration_hint_frames",
        "entities",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string"
        },
        "performance_context": {
          "$ref": "#/$defs/performance_context"
        },
        "duration_hint_frames": {
          "type": "integer",
          "minimum": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "caption_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/caption_segment"
          }
        },
        "caption_timing_status": {
          "type": "string"
        },
        "layout_contract": {
          "$ref": "#/$defs/layout_contract"
        },
        "render_density_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_characters",
            "max_prominent_props",
            "max_prominent_effects"
          ],
          "properties": {
            "max_characters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "max_prominent_props": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "max_prominent_effects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "spatial_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spatial_binding"
          }
        }
      }
    },
    "caption_segment": {
      "type": "object",
      "required": [
        "text",
        "start_ms",
        "end_ms",
        "max_lines",
        "preferred_breaks"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "preferred_breaks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "layout_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "caption_safe_zone",
        "character_zone",
        "prop_zone",
        "effect_zone"
      ],
      "properties": {
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "caption_safe_zone": {
          "$ref": "#/$defs/zone"
        },
        "character_zone": {
          "$ref": "#/$defs/zone"
        },
        "prop_zone": {
          "$ref": "#/$defs/zone"
        },
        "effect_zone": {
          "$ref": "#/$defs/zone"
        }
      }
    },
    "spatial_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "anchor",
        "relation",
        "max_distance_px"
      ],
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "enum": [
            "near",
            "held_by",
            "on_surface",
            "emitted_by",
            "points_to"
          ]
        },
        "max_distance_px": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1200
        }
      }
    }
  },
  "properties": {
    "format": {
      "const": "zodiac-authoring-ir@1"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "video": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  }
}
