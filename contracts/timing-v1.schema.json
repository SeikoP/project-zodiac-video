{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac.local/contracts/timing-v1.schema.json",
  "type": "object",
  "required": [
    "format",
    "fps",
    "total_duration_frames",
    "scenes"
  ],
  "additionalProperties": false,
  "$defs": {
    "caption": {
      "type": "object",
      "required": [
        "text",
        "startMs",
        "endMs",
        "timestampMs"
      ],
      "additionalProperties": true,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "number",
          "minimum": 0
        },
        "endMs": {
          "type": "number",
          "minimum": 0
        },
        "timestampMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "start_frame",
        "duration_frames",
        "captions"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "captions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caption"
          }
        }
      }
    }
  },
  "properties": {
    "format": {
      "const": "zodiac-timing@1"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "total_duration_frames": {
      "type": "integer",
      "minimum": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  }
}
