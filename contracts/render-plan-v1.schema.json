{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zodiac.local/contracts/render-plan-v1.schema.json",
  "type": "object",
  "required": [
    "format",
    "fps",
    "video",
    "assets",
    "scenes"
  ],
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "scene_id",
        "target",
        "start_frame",
        "end_frame",
        "state_before",
        "state_after",
        "motion",
        "asset_before",
        "asset_after"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        },
        "preferred_start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "state_before": {
          "type": "string",
          "minLength": 1
        },
        "state_after": {
          "type": "string",
          "minLength": 1
        },
        "motion": {
          "type": "string",
          "minLength": 1
        },
        "merged_event_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asset_before": {
          "type": "string",
          "minLength": 1
        },
        "asset_after": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "start_frame",
        "duration_frames",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "measured_duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "captions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caption"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "asset"
      ],
      "additionalProperties": true,
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "transform": {
          "type": "object",
          "additionalProperties": true
        },
        "layer": {
          "type": "integer"
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "initial_state",
        "states"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "initial_state": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        }
      }
    },
    "caption": {
      "type": "object",
      "required": [
        "text",
        "start_frame",
        "end_frame"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "paper": {
          "type": "string",
          "minLength": 1
        },
        "ink": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "object",
          "additionalProperties": true
        },
        "watermark": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "properties": {
    "format": {
      "const": "zodiac-render-plan@1"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "video": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    }
  }
}
