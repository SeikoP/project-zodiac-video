 if(manifest.contracts?.character_components!=='characters/components/catalog.json'||manifest.contracts?.character_assembly!=='characters/assembly-contract.md')fail('character assembly routing');if(!manifest.pipeline?.includes('character_assembly'))fail('character assembly pipeline stage');
