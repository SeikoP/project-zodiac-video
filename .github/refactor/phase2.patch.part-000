 for(const item of migration.ready_exemplars??[]){if(!(await exists(item.v4_path)))fail('missing exemplar '+item.v4_path);const svg=await readFile(path.join(root,item.v4_path),'utf8');validateHumanStroke(svg,item.kind==='character'?'character':item.kind==='effect'?'support':'focal');}
 if(props.format!=='zodiac-v4-prop-catalog@1'||props.policy?.full_scene_backgrounds!==false||props.assets?.length<10)fail('V4 props catalog');for(const item of props.assets){if(!(await exists(item.path)))fail('missing prop '+item.id);validateHumanStroke(await readFile(path.join(root,item.path),'utf8'),'focal');}
