diff --git a/plugins/zodiac-video-pipeline/skills/zodiac-video-pipeline/references/asset-library-v4/selection-guide.md b/plugins/zodiac-video-pipeline/skills/zodiac-video-pipeline/references/asset-library-v4/selection-guide.md
